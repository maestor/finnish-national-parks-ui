{
  "name": "finnish-national-parks-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "next build",
    "predev": "npm run copy:maplibre-worker",
    "prebuild": "npm run copy:maplibre-worker",
    "copy:maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "start": "next start",
    "lint": "biome check . && npm run lint:tailwind:canonical",
    "lint:fix": "biome check --write . && npm run lint:tailwind:canonical:fix",
    "lint:tailwind:canonical": "node scripts/check-tailwind-canonical.mjs",
    "lint:tailwind:canonical:fix": "node scripts/check-tailwind-canonical.mjs --write",
    "format": "biome format --write .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "verify": "npm run typecheck && npm run lint:fix && npm run test:coverage && npm run build",
    "generate:api-types": "openapi-typescript http://localhost:3004/openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "maplibre-gl": "^6.6.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
